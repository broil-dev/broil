diff --git a/russh/src/keys/mod.rs b/russh/src/keys/mod.rs
index 01344dc..90ed97f 100644
--- a/russh/src/keys/mod.rs
+++ b/russh/src/keys/mod.rs
@@ -66,0 +67 @@ use thiserror::Error;
+use zeroize::Zeroizing;
@@ -253,3 +254,18 @@ pub fn load_secret_key<P: AsRef<Path>>(
-    let mut secret_file = std::fs::File::open(secret_)?;
-    let mut secret = String::new();
-    secret_file.read_to_string(&mut secret)?;
+    let secret_file = std::fs::File::open(secret_)?;
+    let file_len = usize::try_from(secret_file.metadata()?.len()).map_err(|_| {
+        std::io::Error::new(std::io::ErrorKind::InvalidData, "secret key file is too large")
+    })?;
+    let capacity = file_len.checked_add(1).ok_or_else(|| {
+        std::io::Error::new(std::io::ErrorKind::InvalidData, "secret key file is too large")
+    })?;
+    let mut secret = Zeroizing::new(String::with_capacity(capacity));
+    let bytes_read = secret_file
+        .take(capacity as u64)
+        .read_to_string(&mut secret)?;
+    if bytes_read > file_len {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "secret key file changed while reading",
+        )
+        .into());
+    }
